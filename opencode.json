{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000
    },
    "servers": {
      "menu-filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "C:\\Users\\Flor Alcaraz\\.gemini\\antigravity\\scratch\\menu-pizarron-saas"
        ],
        "disabled": false
      },
      "memory-graph": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
        "disabled": false
      },
      "playwright-testing": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": false,
        "timeout": {
          "catalog": 60000
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": false
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "disabled": false
      },
      "supabase": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@supabase/mcp-server-supabase@latest",
          "--read-only",
          "--project-ref=olqdcudvstbawkcvsfdd"
        ],
        "environment": {
          "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
        },
        "disabled": false,
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        }
      },
      "osv-scanner": {
        "type": "local",
        "command": [
          "C:\\Users\\Flor Alcaraz\\.local\\bin\\osv-scanner.exe",
          "experimental-mcp"
        ],
        "disabled": false
      },
      "semgrep": {
        "type": "local",
        "command": [
          "C:\\Users\\Flor Alcaraz\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\semgrep.exe",
          "mcp"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 60000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "playwright-testing_browser_run_code_unsafe",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "menu-filesystem_write_file",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "menu-filesystem_edit_file",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "menu-filesystem_move_file",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "menu-filesystem_create_directory",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
