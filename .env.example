# Configuración del Servidor y Dominio
PORT=3000
NODE_ENV=production
APP_URL=https://menu-pizarron.vercel.app
JWT_SECRET=super_secreto_para_firmar_tokens_cambiar_en_produccion_2026
GROUP_CART_SECRET=secreto_aleatorio_largo_para_firmar_qr_de_mesa
ADMIN_KEY=clave_maestra_para_el_panel_dueno_admin_2026
# Secreto para autenticar llamadas de Vercel Cron a /api/cron/*
CRON_SECRET=generar_un_secreto_aleatorio_largo

# Client ID OAuth 2.0 de Google Identity Services (dominios autorizados configurados en Google Cloud)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# Opcional: Clave secreta Base32 para 2FA con Google Authenticator (Ej: JBSWY3DPEHPK3PXP)
ADMIN_TOTP_SECRET=

# Base de Datos en la Nube: Supabase (PostgreSQL Gratuito - Recomendado para Vercel)
# Obtené tus credenciales gratis en https://supabase.com
SUPABASE_URL=https://tu-proyecto.supabase.co
# Solo backend/Vercel. Nunca exponer esta clave al navegador.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave pública para inicializar Supabase Realtime en el navegador; está protegida por RLS.
SUPABASE_ANON_KEY=tu_anon_key_publica

# ════════════ PASARELAS DE PAGO (Billing) ════════════
# Resolución: UY/AR → Mercado Pago (si tiene token); resto del mundo →
# DEFAULT_BILLING_PROVIDER (lemonsqueezy por defecto), con fallback a la
# primera pasarela configurada. Sin credenciales la API responde 503
# PAYMENT_PROVIDER_NOT_CONFIGURED con las variables faltantes.

# Pasarela 1: Lemon Squeezy (Merchant of Record Global - Recomendado)
LEMONSQUEEZY_API_KEY=tu_api_key_de_lemonsqueezy
LEMONSQUEEZY_STORE_ID=tu_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=tu_secreto_webhook
# Genéricos por período (fallback si no se define el plan exacto)
LEMONSQUEEZY_PLAN_MONTHLY_VARIANT_ID=var_monthly_123
LEMONSQUEEZY_PLAN_ANNUAL_VARIANT_ID=var_annual_456
# Opcional: variante exacta por plan (starter $9/$79 · pro $19/$159)
# LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
# LEMONSQUEEZY_VARIANT_STARTER_ANNUAL=
# LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
# LEMONSQUEEZY_VARIANT_PRO_ANNUAL=

# Pasarela 2: Stripe Billing (Global con LLC)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Genéricos por período (fallback si no se define el plan exacto)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Opcional: precio exacto por plan
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=

# Pasarela 3: Mercado Pago (Uruguay / Argentina)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# Se adjunta al notification_url y se exige en ?secret= al webhook
MERCADOPAGO_WEBHOOK_SECRET=...
# Moneda de cobro. Default: USD (los planes se publican en USD);
# 'AR' resuelve ARS si no hay override. Requiere tasa si no es USD.
MERCADOPAGO_CURRENCY=USD
# MERCADOPAGO_FX_UYU=40
# MERCADOPAGO_FX_ARS=1200

# Proveedor por defecto para países fuera de UY/AR (lemonsqueezy | stripe)
DEFAULT_BILLING_PROVIDER=lemonsqueezy

# Motor de E-mails Transaccionales (Resend o SMTP)
RESEND_API_KEY=re_...
EMAIL_FROM=hola@menu-pizarron.com

# Sentry — Monitoreo de Errores (Opcional en desarrollo)
# Obtén tu DSN en https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Gemini Flash (Importación Automática de Cartas Físicas con IA)
# Obtené tu API key gratuita en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

