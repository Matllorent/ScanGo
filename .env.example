# Configuración del Servidor y Dominio
PORT=3000
NODE_ENV=production
APP_URL=https://menu-pizarron.vercel.app
# Allowlist CORS (coma-separado; APP_URL siempre incluido). Sin Origin se permite.
# PUBLIC_URL/ADMIN_URL/LANDING_URL opcionales para dominios extra.
# PUBLIC_URL=https://menu.ejemplo.com
# ADMIN_URL=https://admin.ejemplo.com
# LANDING_URL=https://www.ejemplo.com
JWT_SECRET=super_secreto_para_firmar_tokens_cambiar_en_produccion_2026
GROUP_CART_SECRET=secreto_aleatorio_largo_para_firmar_qr_de_mesa
ADMIN_KEY=clave_maestra_para_el_panel_dueno_admin_2026
# Secreto para autenticar llamadas de Vercel Cron a /api/cron/*
CRON_SECRET=generar_un_secreto_aleatorio_largo
# Pausa de ventas pre-lanzamiento: con ALLOW_NEW_SUBSCRIPTIONS=false el registro
# y el checkout responden 503 en TODAS las instancias (el toggle del panel es
# solo en memoria y no sobrevive en Vercel). Para vender, borrarla o ponerla
# en true. Default: ventas abiertas.
# ALLOW_NEW_SUBSCRIPTIONS=false

# IndexNow (Bing/Yandex/Seznam/Naver): ping best-effort al guardar el menú.
# El key es el MISMO que servirá el archivo de verificación en https://dominio/{key}.txt
# (patrón obligatorio [0-9a-fA-F-]{8,64} = UUID o string hex con guiones, hasta 64 chars;
#  cualquier otra forma desactiva el feature). Generar uno: node -e "console.log(require('crypto').randomUUID())"
INDEXNOW_KEY=
# INDEXNOW_ENABLED=true  # opcional; default: habilitado si INDEXNOW_KEY es válida

# Client ID OAuth 2.0 de Google Identity Services (dominios autorizados configurados en Google Cloud)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# Opcional: Clave secreta Base32 para 2FA con Google Authenticator (Ej: JBSWY3DPEHPK3PXP)
ADMIN_TOTP_SECRET=

# Base de Datos en la Nube: Supabase (PostgreSQL Gratuito - Recomendado para Vercel)
# Obtené tus credenciales gratis en https://supabase.com
SUPABASE_URL=https://tu-proyecto.supabase.co
# Solo backend/Vercel. Nunca exponer esta clave al navegador.
# Alias aceptado: SUPABASE_SERVICE_KEY (el .env real usa SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave pública para inicializar Supabase Realtime en el navegador; está protegida por RLS.
SUPABASE_ANON_KEY=tu_anon_key_publica
# Cadena de conexión DIRECTA (puerto 5432) — la consume SOLO el workflow de backup
# .github/workflows/backup-supabase.yml como SECRET de GitHub Actions, NO el runtime.
# Formato: postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres
# (o el pooler @aws-0-<region>.pooler.supabase.com:5432). El password es el de la BASE
# DE DATOS (no la anon/service key). Se saca en Supabase → Settings → Database →
# Connection string → URI (variante directa). NO usar el pooler transaccional 6543.
SUPABASE_DB_URL=
# Retención de telemetría (días): el cron mensual /api/cron/telemetry-retention
# purga telemetry_events más viejos que este cutoff. Clamp [30,730]; default 183.
TELEMETRY_RETENTION_DAYS=183

# ════════════ PASARELAS DE PAGO (Billing) ════════════
# Resolución: UY/AR → Mercado Pago (si tiene token); resto del mundo →
# DEFAULT_BILLING_PROVIDER (lemonsqueezy por defecto), con fallback a la
# primera pasarela configurada. Sin credenciales la API responde 503
# PAYMENT_PROVIDER_NOT_CONFIGURED con las variables faltantes.

# Pasarela 1: Lemon Squeezy (Merchant of Record Global - Recomendado)
LEMONSQUEEZY_API_KEY=tu_api_key_de_lemonsqueezy
LEMONSQUEEZY_STORE_ID=tu_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=tu_secreto_webhook
# Genéricos por período (fallback si no se define el plan exacto)
LEMONSQUEEZY_PLAN_MONTHLY_VARIANT_ID=var_monthly_123
LEMONSQUEEZY_PLAN_ANNUAL_VARIANT_ID=var_annual_456
# Opcional: variante exacta por plan (plan único $9/$79)
# LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
# LEMONSQUEEZY_VARIANT_STARTER_ANNUAL=

# Pasarela 2: Stripe Billing (Global con LLC)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Genéricos por período (fallback si no se define el plan exacto)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Opcional: precio exacto por plan
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_ANNUAL=

# Pasarela 3: Mercado Pago (Uruguay / Argentina)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# Se adjunta al notification_url y se exige en ?secret= al webhook
MERCADOPAGO_WEBHOOK_SECRET=...
# Moneda de cobro. Default: USD (los planes se publican en USD);
# 'AR' resuelve ARS si no hay override. Requiere tasa si no es USD.
MERCADOPAGO_CURRENCY=USD
# MERCADOPAGO_FX_UYU=40
# MERCADOPAGO_FX_ARS=1200

# Proveedor por defecto para países fuera de UY/AR (lemonsqueezy | stripe)
DEFAULT_BILLING_PROVIDER=lemonsqueezy

# Motor de E-mails Transaccionales (Resend o SMTP)
RESEND_API_KEY=re_...
EMAIL_FROM=hola@menu-pizarron.com

# Email interno para notificarte de nuevos clientes/registros y suscripciones exitosas.
# Soporta varios separados por coma. Sin valor, la notificacion se omite (no-op).
OWNER_NOTIFICATION_EMAIL=tu-email@dominio.com

# Push Notifications Web (avisar al dueño cuando una mesa llama al mozo)
# Generar el par con: node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
# Sin estas llaves, /api/notifications/send responde 503 PUSH_NOT_CONFIGURED y
# el aviso de mozo desde la mesa se degrada (no rompe el flujo de WhatsApp).
VAPID_PUBLIC_KEY=BNs2IoWWzwKnESN21FlLQTQ639JmHP_zHry-ikJN1Xc_iDAKGvIsrH4wqskuxZ-Bp6BgCWSnaaA3DzoP7Yy8iw0
VAPID_PRIVATE_KEY=generar_par_aleatorio_no_commitear_el_mismo
VAPID_SUBJECT=mailto:soporte@menu-pizarron.com

# CAPTCHA invisible Cloudflare Turnstile (anti-spam/farming en POST /orders)
# Sin estas dos, no se exige nada (flujo actual). Con secreto, el checkout del
# menú adjunta el token solo y el pedido sin token válido → 403.
# Crear el widget (invisible) en https://dash.cloudflare.com/?to=/:account/turnstile
# (para probar: sitekey 1x00000000000000000000BB, secret 1x0000000000000000000000000000000AA = siempre pasa)
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=

# Sentry — Monitoreo de Errores (Opcional en desarrollo)
# Obtén tu DSN en https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Gemini Flash (Importación Automática de Cartas Físicas con IA)
# Obtené tu API key gratuita en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


# CAN-SPAM / RGPD: dirección postal física que va en el pie de TODOS los emails
# (requerida por la ley anti-spam de EEUU y buena práctica RGPD).
COMPANY_POSTAL_ADDRESS=ScanGo — Tu Calle 123, Montevideo, Uruguay
# Secreto opcional para firmar los links de baja (fallback JWT_SECRET).
EMAIL_UNSUB_SECRET=
