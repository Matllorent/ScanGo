{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/m/(.*)",
      "dest": "/public/menu.html"
    },
    {
      "src": "/studio",
      "dest": "/public/studio.html"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/terminos",
      "dest": "/public/terminos.html"
    },
    {
      "src": "/privacidad",
      "dest": "/public/privacidad.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}